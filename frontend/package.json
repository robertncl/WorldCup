{
  "name": "worldcup-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "World Cup 2026 simulator frontend (Bun + TypeScript)",
  "scripts": {
    "build": "bun build src/index.html --outdir dist --minify --sourcemap=linked",
    "dev": "bun build src/index.html --outdir dist --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
